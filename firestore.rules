rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwnerOrAdmin(userId);
    }

    match /appointments/{apptId} {
      allow read: if isOwnerOrAdmin(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwnerOrAdmin(resource.data.userId);
      allow delete: if isAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /alerts/{alertId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if isAdmin() || isOwner(request.resource.data.userId);
    }
    match /translations/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}